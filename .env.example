# Database
MONGODB_URI=mongodb://localhost:27017/mahabaleshwar_db

# Server
PORT=5000

# Admin JWT (required in production — use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Seed admin user: run `npm run create-admin` in backend folder
# If omitted, script uses admin@oraastay.local / Admin@2026! (dev only — change in production)
ADMIN_SEED_EMAIL=admin@oraastay.local
ADMIN_SEED_PASSWORD=Admin@2026!
ADMIN_SEED_NAME=Super Admin

# Optional: extra CORS origins (comma-separated) for admin / preview domains
# CORS_ORIGINS=https://preview-admin.example.com

# PayUMoney Payment Gateway
PAYU_MERCHANT_KEY=your_merchant_key
PAYU_SALT=your_merchant_salt
PAYU_MODE=TEST
# Use TEST for sandbox, LIVE for production

# API Base URL - Your backend API URL (used for PayU callback URLs)
# Example: https://api.oraastay.com
API_BASE_URL=http://localhost:5000

# Frontend URL - Where to redirect after payment success/failure
# Example: https://oraastay.com
FRONTEND_URL=http://localhost:5173

# SMTP Email - Hostinger (for confirmation emails)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-email-password
SMTP_FROM=your-email@yourdomain.com
# Use your full Hostinger email (e.g. noreply@oraastay.com) and password. Get details from hPanel → Emails → Manage → Connect Apps & Devices
